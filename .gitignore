*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
# Sans le "/" en tête, ces patterns matchent à toute profondeur — nécessaire
# pour exclure app/build/ et wear/build/, pas seulement un build/ racine.
build/
captures/
.externalNativeBuild
.cxx
local.properties

# .idea/ : on ne garde que la configuration projet partagée (SDK, Gradle,
# compilateur, mapping VCS). Le reste est personnel/local à chaque machine.
/.idea/deploymentTargetSelector.xml
/.idea/markdown.xml
/.idea/runConfigurations.xml

# Config locale d'outils (spécifique machine/session, pas de gouvernance projet)
.claude/settings.local.json

# Clé de signature développeur Connect IQ (garmin/) — privée, équivalent
# d'un keystore Android, jamais commitée.
garmin/developer_key.der
garmin/developer_key.pem
garmin/bin/
garmin/gen/

# Clé de signature Play Store ("upload key" — voir DECISIONS.md/ROADMAP.md
# Phase 9). Perdre ce fichier n'empêche pas de mettre à jour l'app grâce à
# Play App Signing (Google gère la vraie clé de signature), mais il ne doit
# jamais quitter cette machine — tout le dossier est exclu, y compris les
# mots de passe dans keystore.properties.
keystore/
